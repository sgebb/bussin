@using Bussin.Services.Demo
@using Bussin.Services
@inject NavigationStateService NavState
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ExplorerDialogService DialogService
@implements IDisposable

<div class="nav-menu">
    <!-- Clickable Header -->
    <div class="nav-header">
        <a class="nav-brand" href="/" @onclick:preventDefault @onclick="@(() => Navigation.NavigateTo("/"))">
            <img src="favicon.svg" alt="bussin logo" class="nav-brand-logo" />
            <span class="nav-brand-text">bussin</span>
        </a>
    </div>

    <!-- Scrollable Favorites Section (view only; changes happen in the Organize modal) -->
    <div class="nav-favorites-scroll">
        <nav class="flex-column">
            @if (NavState.RunWithoutLogin)
            {
                @FavoritesPanel
            }
            else
            {
                <AuthorizeView>
                    <Authorized>@FavoritesPanel</Authorized>
                </AuthorizeView>
            }
        </nav>
    </div>

    <!-- Fixed Bottom Section -->
    <div class="nav-footer">
        <div class="user-section-row">
            @if (NavState.RunWithoutLogin)
            {
                <div class="user-section bg-warning text-dark" @onclick="ExitConnectionStringMode" style="cursor: pointer; justify-content: center;">
                    <i class="bi bi-box-arrow-left text-dark"></i>
                    <span class="ms-2 fw-semibold">Exit CS Mode</span>
                </div>
            }
            else if (_isDemoMode)
            {
                <div class="user-section bg-danger text-white" @onclick="ExitDemoMode" style="cursor: pointer; justify-content: center;">
                    <i class="bi bi-box-arrow-left"></i>
                    <span class="ms-2">Exit Demo</span>
                </div>
            }
            else
            {
                <div class="user-section" @onclick="@(() => Navigation.NavigateTo("/user"))" style="cursor: pointer;">
                    <i class="bi bi-person-circle"></i>
                    <span class="ms-2">@userName</span>
                </div>
            }

            <div class="footer-icons">
                <button class="footer-icon-btn d-none d-md-inline-block" @onclick="ShowKeyboardShortcuts" title="Keyboard Shortcuts (Ctrl+K)">
                    <i class="bi bi-keyboard"></i>
                </button>
                <button class="footer-icon-btn" @onclick="OnDarkModeToggle" title="@(IsDarkMode ? "Switch to light mode" : "Switch to dark mode")">
                    <i class="bi @(IsDarkMode ? "bi-brightness-high-fill" : "bi-moon-fill")"></i>
                </button>
                <button class="footer-icon-btn" @onclick="NavState.ShowSupportModalDialog" title="Support & Contribute">
                    <i class="bi bi-heart-fill"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsDarkMode { get; set; }
    [Parameter] public EventCallback OnToggleDarkMode { get; set; }

    private string userName = "User";
    private bool _isDemoMode;

    protected override async Task OnInitializedAsync()
    {
        NavState.OnChange += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;

        // Detect demo mode by checking if the provider is our custom demo provider
        _isDemoMode = AuthenticationStateProvider is DemoAuthenticationStateProvider;

        // Get authenticated user name
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userName = authState.User.Identity?.Name?.Split('@')[0] ?? "User";
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private async Task OnDarkModeToggle()
    {
        await OnToggleDarkMode.InvokeAsync();
    }

    private void ExitDemoMode()
    {
        // Force full reload to verify auth check again in Program.cs
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private async Task ExitConnectionStringMode()
    {
        await NavState.SetRunWithoutLoginAsync(false);
        Navigation.NavigateTo("/", forceLoad: true);
    }

    public void Dispose()
    {
        NavState.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private string GetExplorerUrl(NamespaceConnection ns)
    {
        return $"explorer?namespace={Uri.EscapeDataString(ns.FullyQualifiedNamespace)}&rg={Uri.EscapeDataString(ns.ResourceGroup)}&sub={Uri.EscapeDataString(ns.SubscriptionId)}&name={Uri.EscapeDataString(ns.DisplayName)}";
    }

    private RenderFragment FavoritesPanel => @<text>
        @if (NavState.IsInitialized)
        {
            var defaultFolder = NavState.GetFolder(NavState.GetDefaultFolderIdValue());
            var otherFolders = NavState.GetRootFolders().Where(f => f.Id != defaultFolder?.Id).ToList();
            <div class="px-3 mt-3">
                <div class="favorites-heading">
                    <span>Favorites</span>
                    @if (NavState.HasFavorites)
                    {
                        <button class="favorites-organize-btn" @onclick="NavState.ShowOrganizeFavoritesModalDialog"
                                title="Rename, move and remove favorites, and manage folders">
                            <i class="bi bi-pencil"></i> Organize
                        </button>
                    }
                </div>

                @if (NavState.HasFavorites)
                {
                    @foreach (var ns in defaultFolder?.Namespaces ?? [])
                    {
                        @NamespaceTile(ns)
                    }
                    @foreach (var folder in otherFolders)
                    {
                        @FolderBlock((folder, 0))
                    }
                }
                else
                {
                    <p class="favorites-empty">
                        <i class="bi bi-star"></i> Star a namespace to pin it here for quick access.
                    </p>
                }
            </div>
        }
    </text>;

    private RenderFragment<NamespaceConnection> NamespaceTile => ns =>
        @<div class="recent-namespace-tile d-block mb-2 p-2 user-select-none" style="cursor: pointer;"
              @onclick="() => Navigation.NavigateTo(GetExplorerUrl(ns))">
            <div class="fw-semibold text-truncate" title="@ns.DisplayName">@ns.DisplayName</div>
            <small class="text-muted text-truncate d-block" title="@ns.FullyQualifiedNamespace">@ns.FullyQualifiedNamespace</small>
        </div>;

    private RenderFragment<(Folder Folder, int Depth)> FolderBlock => item => __builder =>
    {
        var folder = item.Folder;
        var childFolders = NavState.GetChildFolders(folder.Id).ToList();
        <div class="mb-2" style="@(item.Depth > 0 ? $"margin-left: {item.Depth}rem;" : "")">
            <div class="folder-header text-truncate" style="cursor: pointer;" @onclick="() => NavState.ToggleFolderExpandedAsync(folder.Id)">
                <span class="me-2">@(folder.IsExpanded ? "▼" : "▶")</span>
                <strong>@folder.Name</strong>
                <small class="text-muted ms-2">(@(folder.Namespaces.Count + childFolders.Count))</small>
            </div>
            @if (folder.IsExpanded)
            {
                <div class="mt-2 ms-3">
                    @foreach (var ns in folder.Namespaces)
                    {
                        @NamespaceTile(ns)
                    }
                    @foreach (var child in childFolders)
                    {
                        @FolderBlock((child, item.Depth + 1))
                    }
                </div>
            }
        </div>
    };

    private void ShowKeyboardShortcuts()
    {
        DialogService.ShowKeyboardShortcutsModal = true;
    }
}
