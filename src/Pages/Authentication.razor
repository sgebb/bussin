@page "/authentication/{action}"
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

@code {
    [Parameter]
    public string? Action { get; set; }

    // Entra returns here after sign-in (login-callback) and sign-out (logout-callback). MSAL has already
    // processed any response during start-up (msalHelper.init), so all that's left is to go back to where
    // sign-in started.
    protected override async Task OnInitializedAsync()
    {
        var returnUrl = await JSRuntime.InvokeAsync<string?>("msalHelper.takeReturnUrl");
        if (returnUrl is not null)
        {
            Navigation.NavigateTo(returnUrl, replace: true);
        }
    }
}
