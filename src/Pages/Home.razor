@page "/"
@using Microsoft.JSInterop
@using System.Text.Json
@inject IAuthenticationService AuthService
@inject IAzureResourceService ResourceService
@inject NavigationManager Navigation
@inject NavigationStateService NavState
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject INotificationService NotificationService
@implements IDisposable

<PageTitle>bussin</PageTitle>

@if (isAuthenticated || NavState.RunWithoutLogin)
{
    <div class="container-fluid p-4">
        @if (NavState.RunWithoutLogin)
        {
            <div class="alert alert-info border-info shadow-sm mb-4 py-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-info-circle-fill text-info fs-4"></i>
                    <div>
                        <h6 class="mb-0 fw-bold">Connection String Mode (Bypass Login)</h6>
                        <small class="text-muted">You are running without logging in. Azure resource discovery is disabled. Connect manually to your namespaces below.</small>
                    </div>
                </div>
                <button class="btn btn-sm btn-primary fw-semibold" @onclick="SwitchToEntraLogin">
                    <i class="bi bi-microsoft me-1"></i> Sign in with Microsoft
                </button>
            </div>
        }

        @if (NavState.RunWithoutLogin)
        {
            <div class="d-flex align-items-center justify-content-between mb-3 mt-2">
                <h3 class="h5 mb-0 text-secondary"><i class="bi bi-link-45deg"></i> Manual Connections & Emulators</h3>
                <button class="btn btn-sm btn-primary" @onclick="OpenAddManualModal">
                    <i class="bi bi-plus-circle me-1"></i> Add namespace
                </button>
            </div>

            @if (manualNamespaces.Count == 0)
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-link-45deg display-4 text-muted mb-3 d-block"></i>
                        <h6>No manual connections configured</h6>
                        <p class="text-muted small mb-3">Add a connection string to a Service Bus namespace or local emulator to start browsing.</p>
                        <button class="btn btn-sm btn-primary px-3 fw-semibold" @onclick="OpenAddManualModal">
                            <i class="bi bi-plus-circle me-1"></i> Add namespace
                        </button>
                    </div>
                </div>
            }
            else
            {
                @ManualNamespaceCards
            }
        }

        @if (isAuthenticated)
        {
            @if (hasArmPermission || isCheckingPermissions)
            {
                <div class="row justify-content-center mb-4 mt-2">
                    <div class="col-lg-8">
                        <div class="d-flex align-items-center gap-3">
                            <div class="position-relative flex-grow-1">
                                <input type="text" class="form-control form-control-lg text-center" placeholder="Search namespaces..." 
                                       @bind="searchTerm" @bind:event="oninput" />
                                @if (isRefreshing)
                                {
                                    <div class="position-absolute top-50 end-0 translate-middle-y me-3">
                                        <div class="spinner-border spinner-border-sm text-muted" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </div>
                                }
                            </div>
                            <a href="user" class="text-secondary text-decoration-none text-nowrap small" title="Can't find your namespace? Check your tenant settings.">
                                <small><i class="bi bi-question-circle me-1"></i>Wrong Tenant?</small>
                            </a>
                        </div>
                    </div>
                </div>
            }

            @if (isCheckingPermissions && namespaces.Count == 0)
            {
                <div class="text-center my-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Checking permissions...</span>
                    </div>
                    <p class="mt-2 text-muted">Checking permissions...</p>
                </div>
            }
            else if (access is { IsComplete: false } && !isGrantingAccess)
            {
                <div class="alert alert-warning border-warning shadow-sm">
                    @switch (access.Problem)
                    {
                        case AccessProblem.SignInRequired:
                            <h5 class="alert-heading d-flex align-items-center gap-2">
                                <i class="bi bi-person-lock"></i> Sign In Again
                            </h5>
                            <p class="mb-4">
                                Your Microsoft sign-in@(InTenant(" to")) is no longer valid.
                                This usually happens after a password change, or when your organization requires you to sign in again.
                            </p>
                            break;

                        case AccessProblem.ConsentRequired:
                            <h5 class="alert-heading d-flex align-items-center gap-2">
                                <i class="bi bi-shield-lock-fill"></i> Permission Required
                            </h5>
                            <p class="mb-3">
                                <strong>bussin</strong> needs your permission to discover and manage your resources@(InTenant(" in")).
                                This is a secure <strong>client-side only</strong> app: all tokens stay in your browser,
                                and it cannot perform any actions unless you instigate them yourself.
                            </p>
                            <p class="small text-muted mb-4">
                                Azure separates resource discovery from data operations, so you'll be asked to consent to both:
                            </p>
                            <div class="list-group list-group-flush bg-transparent mb-4">
                                <div class="list-group-item bg-transparent border-0 d-flex gap-3 px-0">
                                    <i class="bi @(hasArmPermission ? "bi-check-circle-fill text-success" : "bi-circle text-muted") fs-5"></i>
                                    <div>
                                        <h6 class="mb-0 @(hasArmPermission ? "text-success" : "")">Azure Management API</h6>
                                        <small class="text-muted d-block mb-1">Allows <strong>bussin</strong> to list your Service Bus namespaces so you can select them.</small>
                                        <div class="x-small text-info"><i class="bi bi-info-circle me-1"></i> Purpose: Resource Discovery & Enumeration</div>
                                    </div>
                                </div>
                                <div class="list-group-item bg-transparent border-0 d-flex gap-3 px-0">
                                    <i class="bi @(hasSbPermission ? "bi-check-circle-fill text-success" : "bi-circle text-muted") fs-5"></i>
                                    <div>
                                        <h6 class="mb-0 @(hasSbPermission ? "text-success" : "")">Service Bus Data Plane</h6>
                                        <small class="text-muted d-block mb-1">Allows <strong>bussin</strong> to peek, send, and monitor messages within your queues and topics.</small>
                                        <div class="x-small text-info"><i class="bi bi-info-circle me-1"></i> Purpose: Message Operations & Monitoring</div>
                                    </div>
                                </div>
                            </div>
                            break;

                        default:
                            <h5 class="alert-heading d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-triangle-fill"></i> Couldn't Access Azure
                            </h5>
                            <p class="mb-2">Microsoft Entra ID returned an error@(InTenant(" for")):</p>
                            <pre class="small bg-body-tertiary p-2 rounded mb-4" style="white-space: pre-wrap;">@access.ErrorMessage</pre>
                            break;
                    }

                    @if (!string.IsNullOrEmpty(grantErrorMessage))
                    {
                        <div class="alert alert-danger mb-3 py-2 small">
                            <i class="bi bi-exclamation-octagon me-2"></i> @grantErrorMessage
                        </div>
                    }

                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-warning px-4 fw-bold" @onclick="GrantAccess">
                            @switch (access.Problem)
                            {
                                case AccessProblem.SignInRequired:
                                    <i class="bi bi-box-arrow-in-right me-2"></i><span>Sign In Again</span>
                                    break;
                                case AccessProblem.ConsentRequired:
                                    <i class="bi bi-shield-shaded me-2"></i><span>Grant Required Permissions</span>
                                    break;
                                default:
                                    <i class="bi bi-arrow-clockwise me-2"></i><span>Try Again</span>
                                    break;
                            }
                        </button>
                        @if (!string.IsNullOrEmpty(currentTenantId))
                        {
                            <button class="btn btn-outline-secondary px-3" @onclick="SwitchToHomeTenant">
                                <i class="bi bi-house-door me-2"></i> Switch back to Home Tenant
                            </button>
                        }
                    </div>
                </div>
            }
            else if (isGrantingAccess)
            {
                <div class="alert alert-info border-info shadow-sm">
                    <div class="d-flex align-items-center gap-3">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">Authenticating...</h6>
                            <span class="text-muted small">Complete the sign-in in the popup window.</span>
                        </div>
                    </div>
                </div>
            }
            
            @if (hasArmPermission || isCheckingPermissions)
            {
                @if (isRefreshing && namespaces.Count == 0)
                {
                    <div class="text-center mb-3">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (namespaces.Count > 0)
                {
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3">
                        <div class="col-md-4 mb-3">
                            <button class="card h-100 w-100 namespace-card add-namespace-card" @onclick="OpenAddManualModal">
                                <span class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                                    <i class="bi bi-plus-circle fs-3 mb-2"></i>
                                    <span class="fw-bold">Add namespace</span>
                                    <small class="text-muted">Not listed here? Connect with a connection string.</small>
                                </span>
                            </button>
                        </div>
                        @foreach (var ns in FilteredNamespaces)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card h-100 namespace-card" style="cursor: pointer;" @onclick="() => NavigateToExplorer(ns)">
                                    <button class="favorite-btn @(NavState.IsFavorite(ns.FullyQualifiedNamespace) ? "favorited" : "not-favorited")" 
                                            @onclick="async () => await ToggleFavorite(ns.FullyQualifiedNamespace)" 
                                            @onclick:stopPropagation="true"
                                            title="@(NavState.IsFavorite(ns.FullyQualifiedNamespace) ? "Remove from favorites" : "Add to favorites")">
                                        <i class="bi @(NavState.IsFavorite(ns.FullyQualifiedNamespace) ? "bi-star-fill" : "bi-star")"></i>
                                    </button>
                                    <div class="card-body pb-4">
                                        <h5 class="card-title fw-bold">@ns.Name</h5>
                                        <p class="card-text text-muted mb-0 small">
                                            <strong>Subscription:</strong> @ns.SubscriptionName<br />
                                            <strong>Resource Group:</strong> @ns.ResourceGroup<br />
                                            <strong>Location:</strong> @ns.Location<br />
                                            <strong>Tenant:</strong> @ns.TenantId
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (!isRefreshing && hasArmPermission)
                {
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body text-center p-5">
                                    <i class="bi bi-search display-1 text-muted mb-4"></i>
                                    <h4 class="mb-3">No Service Bus Namespaces Found</h4>
                                    <p class="text-muted mb-4 lead">
                                        We checked your subscriptions but couldn't find any Service Bus namespaces.
                                    </p>
                                    
                                    <div class="d-flex justify-content-center gap-3 mb-4">
                                        <div class="text-start">
                                            <h6 class="text-secondary"><i class="bi bi-question-circle me-2"></i>Common Reasons:</h6>
                                            <ul class="text-muted small">
                                                <li>You haven't created any namespaces yet.</li>
                                                <li>You don't have the <code>Reader</code> role on the resource.</li>
                                                <li>The namespace is in a different Azure AD tenant.</li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-center gap-2">
                                        <a href="https://portal.azure.com/#create/Microsoft.ServiceBus" target="_blank" class="btn btn-primary">
                                            <i class="bi bi-plus-lg me-2"></i>Create Namespace
                                        </a>
                                        <button class="btn btn-outline-secondary" @onclick="OpenAddManualModal">
                                            <i class="bi bi-link-45deg me-2"></i>Add with connection string
                                        </button>
                                        <a href="user" class="btn btn-outline-secondary">
                                            <i class="bi bi-person-gear me-2"></i>Check Tenant
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

            @if (manualNamespaces.Count > 0)
            {
                <h3 class="h6 text-secondary mt-4 mb-3"><i class="bi bi-link-45deg"></i> Connection string namespaces</h3>
                @ManualNamespaceCards
            }
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3">
                <strong>Error:</strong> @errorMessage
            </div>
        }
    </div>
}
else
{
    <Welcome />
}



<style>
    .btn-xs {
        padding: 0.15rem 0.35rem;
        font-size: 0.75rem;
        border-radius: 4px;
    }

    .add-namespace-card {
        border-style: dashed !important;
        background: transparent !important;
        color: var(--text-color);
        min-height: 140px;
    }

    .add-namespace-card:hover {
        border-color: var(--link-color) !important;
        color: var(--link-color);
    }
</style>

@code {
    private Dictionary<string, ServiceBusNamespaceInfo> namespaceDict = new();
    private List<ServiceBusNamespaceInfo> namespaces => namespaceDict.Values.OrderBy(ns => ns.Name).ToList();
    private List<NamespaceConnection> manualNamespaces = new();
    private bool isRefreshing = false;
    private string? errorMessage;
    private string searchTerm = "";
    private CancellationTokenSource? _loadCts;
    private AccessStatus? access;
    private bool hasArmPermission => access?.Management == AccessProblem.None;
    private bool hasSbPermission => access?.ServiceBus == AccessProblem.None;
    private bool isGrantingAccess = false;
    private string? grantErrorMessage = null;
    private bool isCheckingPermissions = false;
    private bool isAuthenticated = false;

    private string? currentTenantName;
    private string? currentTenantId;

    // " in Contoso" when a guest tenant is selected, otherwise nothing.
    private string InTenant(string preposition) =>
        string.IsNullOrEmpty(currentTenantId) ? "" : $"{preposition} {currentTenantName ?? currentTenantId}";

    private RenderFragment ManualNamespaceCards => @<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 mb-5">
        @foreach (var ns in manualNamespaces)
        {
            <div class="col">
                <div class="card h-100 namespace-card position-relative" style="cursor: pointer;" @onclick="() => NavigateToManualExplorer(ns)">
                    <div class="card-body pb-5">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h5 class="card-title text-truncate pe-5 mb-0 fw-bold" title="@ns.DisplayName">@ns.DisplayName</h5>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2">SAS</span>
                        </div>
                        <p class="card-text text-muted mb-0 small text-truncate" title="@ns.FullyQualifiedNamespace">
                            <strong>Endpoint:</strong> @ns.FullyQualifiedNamespace
                        </p>
                        @if (!string.IsNullOrEmpty(ns.WebSocketUrl))
                        {
                            <p class="card-text text-muted small text-truncate" title="@ns.WebSocketUrl">
                                <strong>WebSocket:</strong> @ns.WebSocketUrl
                            </p>
                        }
                        else
                        {
                            <p class="card-text text-muted small">
                                <strong>WebSocket:</strong> Default (Secure)
                            </p>
                        }
                        <div class="card-text mt-2 d-flex gap-2">
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Queues: @ns.ConfiguredQueues.Count</span>
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Topics: @ns.ConfiguredTopics.Count</span>
                        </div>
                    </div>
                    <div class="position-absolute bottom-0 end-0 p-2 d-flex gap-1" @onclick:stopPropagation="true">
                        <button class="btn btn-xs btn-outline-secondary" @onclick="() => OpenEditManualModal(ns)" title="Edit connection settings">
                            <i class="bi bi-gear"></i>
                        </button>
                        <button class="btn btn-xs btn-outline-danger" @onclick="() => DeleteManualNamespace(ns)" title="Delete connection">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>;

    private void OpenAddManualModal()
    {
        NavState.ShowAddConnectionStringModalDialog(null);
    }

    private void OpenEditManualModal(NamespaceConnection ns)
    {
        NavState.ShowAddConnectionStringModalDialog(ns);
    }

    private async Task DeleteManualNamespace(NamespaceConnection ns)
    {
        await NavState.RemoveFromFavoritesAsync(ns.FullyQualifiedNamespace);
        LoadManualNamespaces();
        NotificationService.NotifySuccess("Manual connection deleted.");
    }

    private void NavigateToManualExplorer(NamespaceConnection ns)
    {
        var url = $"explorer?namespace={Uri.EscapeDataString(ns.FullyQualifiedNamespace)}&rg={Uri.EscapeDataString(ns.ResourceGroup)}&sub={Uri.EscapeDataString(ns.SubscriptionId)}&name={Uri.EscapeDataString(ns.DisplayName)}";
        Navigation.NavigateTo(url);
    }

    private async Task SwitchToEntraLogin()
    {
        await NavState.SetRunWithoutLoginAsync(false);
        await AuthService.SignInAsync();
    }

    private void LoadManualNamespaces()
    {
        manualNamespaces = NavState.Folders
            .SelectMany(f => f.Namespaces)
            .Where(ns => !string.IsNullOrEmpty(ns.ConnectionString))
            .ToList();
    }

    private void OnNavStateChange()
    {
        LoadManualNamespaces();
        InvokeAsync(StateHasChanged);
    }

    private IEnumerable<ServiceBusNamespaceInfo> FilteredNamespaces => 
        string.IsNullOrWhiteSpace(searchTerm) 
            ? namespaces 
            : namespaces.Where(ns => 
                ns.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                (ns.SubscriptionName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                ns.ResourceGroup.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        NavState.OnChange += OnNavStateChange;
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
        LoadManualNamespaces();
        
        if (isAuthenticated)
        {
            isCheckingPermissions = true;
            
            // Start loading namespaces from cache/network immediately to leverage instant cache rendering
            _ = LoadNamespacesAsync();
            
            // Check permissions in the background to avoid blocking the initial cache render
            _ = CheckPermissionsAsync();
        }
    }

    private async Task CheckPermissionsAsync()
    {
        await CheckPermissions();
        isCheckingPermissions = false;
        StateHasChanged();
    }

    private async Task CheckPermissions()
    {
        try
        {
            // Try to find the tenant name for the UI
            currentTenantId = await AuthService.GetCurrentTenantIdAsync();

            if (!string.IsNullOrEmpty(currentTenantId))
            {
                var homeCred = await AuthService.GetHomeTokenCredentialAsync();
                if (homeCred != null)
                {
                    await foreach (var tenant in ResourceService.ListTenantsAsync(homeCred))
                    {
                        if (tenant.TenantId == currentTenantId)
                        {
                            currentTenantName = tenant.DisplayName;
                            break;
                        }
                    }
                }
            }

            access = await AuthService.CheckAccessAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking permissions: {ex.Message}");
            access = new AccessStatus(AccessProblem.Failed, AccessProblem.Failed, ex.Message);
        }
    }

    private async Task SwitchToHomeTenant()
    {
        await AuthService.SetTenantAsync(null);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    // The same popup fixes every problem the card can show: it signs in again if needed and consents to both
    // resources at once. The reload then re-checks, so anything still wrong shows up on the card again.
    private async Task GrantAccess()
    {
        isGrantingAccess = true;
        grantErrorMessage = null;

        grantErrorMessage = await AuthService.GrantAccessAsync();
        if (grantErrorMessage is null)
        {
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
            return;
        }

        isGrantingAccess = false;
    }

    private async Task LoadNamespacesAsync()
    {
        _loadCts?.Cancel();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        isRefreshing = true;
        errorMessage = null;

        try
        {
            var credential = await AuthService.GetTokenCredentialAsync();
            if (credential == null)
            {
                // CheckPermissions explains why on the access card.
                isRefreshing = false;
                return;
            }

            await foreach (var ns in ResourceService.ListServiceBusNamespacesAsync(credential, ct))
            {
                if (ct.IsCancellationRequested) break;
                namespaceDict[ns.Name] = ns;
                StateHasChanged();
            }
            
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load namespaces: {ex.Message}";
        }
        finally
        {
            isRefreshing = false;
            StateHasChanged();
        }
    }

    private void NavigateToExplorer(ServiceBusNamespaceInfo ns)
    {
        var url = $"explorer?namespace={Uri.EscapeDataString(ns.FullyQualifiedNamespace)}&rg={Uri.EscapeDataString(ns.ResourceGroup)}&sub={Uri.EscapeDataString(ns.SubscriptionId)}&name={Uri.EscapeDataString(ns.Name)}";
        Navigation.NavigateTo(url);
    }

    private async Task ToggleFavorite(string fullyQualifiedNamespace)
    {
        var ns = namespaces.FirstOrDefault(n => n.FullyQualifiedNamespace == fullyQualifiedNamespace);
        if (ns == null) return;

        if (NavState.IsFavorite(fullyQualifiedNamespace))
        {
            await NavState.RemoveFromFavoritesAsync(fullyQualifiedNamespace);
        }
        else
        {
            var displayName = ns.Name.Replace(".servicebus.windows.net", "");
            await NavState.AddToFavoritesAsync(fullyQualifiedNamespace, ns.ResourceGroup, ns.SubscriptionId, displayName);
        }
    }

    public void Dispose()
    {
        NavState.OnChange -= OnNavStateChange;
    }
}
