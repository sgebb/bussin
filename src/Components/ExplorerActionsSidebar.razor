<div class="explorer-actions-sidebar">
    <!-- Send + DLQ Toggle Row -->
    @* Hidden on phones: no Send there, and the DLQ toggle sits in the explorer header instead *@
    <div class="send-dlq-row desktop-only">
        <button class="btn btn-action btn-primary send-btn @(!CanSend ? "disabled-grey" : "")"
                @onclick="OnShowSendMessage"
                disabled="@(!CanSend)"
                title="Send a message">
            <i class="bi bi-envelope-fill"></i> Send
        </button>
        <button class="dlq-toggle-btn @(IsViewingDLQ ? "active" : "") @(!HasQueueOrSubscriptionSelected ? "disabled-grey" : "")"
                @onclick="OnToggleDLQ"
                disabled="@(!HasQueueOrSubscriptionSelected)"
                title="@(HasQueueOrSubscriptionSelected ? (IsViewingDLQ ? "Viewing Dead Letter Queue" : "Switch to Dead Letter Queue") : "Select a queue or subscription first")">
            <span>DLQ</span>
            <span class="dlq-checkbox @(IsViewingDLQ ? "checked" : "")">
                @if (IsViewingDLQ)
                {
                    <i class="bi bi-check-square-fill"></i>
                }
                else
                {
                    <i class="bi bi-square"></i>
                }
            </span>
        </button>
    </div>

    <!-- Read Actions -->
    <div class="action-btn-group">
        <div class="action-btn-group-title">Read</div>
        <div class="peek-split">
            <div class="peek-btn-combined @(!HasQueueOrSubscriptionSelected || IsPeeking ? "disabled" : "")">
                <button class="peek-btn-main"
                        @onclick="@(PeekedMessagesCount > 0 ? OnPeekNext : OnPeek)"
                        disabled="@(!HasQueueOrSubscriptionSelected || IsPeeking)">
                    <i class="bi bi-search"></i> @(PeekedMessagesCount > 0 ? "Peek More" : "Peek")
                </button>
                <button class="peek-btn-options desktop-only @(ArePeekOptionsModified ? "text-warning" : "")"
                        @onclick="() => _peekMenuOpen = !_peekMenuOpen"
                        @onclick:stopPropagation="true"
                        disabled="@(!HasQueueOrSubscriptionSelected)"
                        title="@(ArePeekOptionsModified ? "More ways to peek (custom options active)" : "More ways to peek")">
                    <i class="bi bi-caret-down-fill"></i>
                </button>
            </div>
            @if (_peekMenuOpen && HasQueueOrSubscriptionSelected)
            {
                <div class="peek-menu-backdrop" @onclick="() => _peekMenuOpen = false"></div>
                <div class="peek-menu" role="menu">
                    <button class="peek-menu-item" role="menuitem" @onclick="() => RunMenu(OnPeekNewest)">
                        <i class="bi bi-sort-numeric-down-alt"></i>
                        <span><strong>Newest first</strong><small>Peek the latest 50 messages</small></span>
                    </button>
                    <button class="peek-menu-item" role="menuitem" @onclick="() => RunMenu(OnWatch)">
                        <i class="bi bi-broadcast"></i>
                        <span><strong>Watch new messages</strong><small>Show messages as they arrive (M)</small></span>
                    </button>
                    <div class="peek-menu-divider"></div>
                    <button class="peek-menu-item" role="menuitem" @onclick="() => RunMenu(OnShowPeekOptions)">
                        <i class="bi bi-sliders"></i>
                        <span><strong>Advanced peek…</strong><small>Count, start position, filters</small></span>
                    </button>
                </div>
            }
        </div>
        @if (ArePeekOptionsModified && ActivePeekOptions != null)
        {
            <div class="peek-active-options" title="Peek More continues with these options. Clear the list and press Peek to go back to defaults.">
                <i class="bi bi-sliders"></i> @DescribeOptions(ActivePeekOptions)
            </div>
        }
    </div>

    <!-- Modify Actions -->
    <div class="action-btn-group">
        <div class="action-btn-group-title">Modify</div>
        <button class="btn btn-action btn-warning w-100 @(!HasQueueOrSubscriptionSelected || !IsViewingDLQ || CurrentResubmitOperation != null ? "disabled-grey" : "")"
                @onclick="OnResubmitAll"
                disabled="@(!HasQueueOrSubscriptionSelected || !IsViewingDLQ || CurrentResubmitOperation != null)"
                title="@(!IsViewingDLQ ? "Only available when viewing Dead Letter Queue" : CurrentResubmitOperation != null ? "Resubmit already in progress" : "Resubmit all messages from Dead Letter Queue")">
            <i class="bi bi-arrow-repeat"></i> Resubmit All
        </button>
        <button class="btn btn-action btn-danger w-100 @(!HasQueueOrSubscriptionSelected || CurrentPurgeOperation != null ? "disabled-grey" : "")"
                @onclick="OnPurge"
                disabled="@(!HasQueueOrSubscriptionSelected || CurrentPurgeOperation != null)"
                title="@(CurrentPurgeOperation != null ? "Purge already in progress" : "Purge all messages")">
            <i class="bi bi-trash"></i> Purge
        </button>
    </div>

    @if (IsSubscriptionSelected)
    {
        <!-- Filters Actions -->
        <div class="action-btn-group desktop-only">
            <div class="action-btn-group-title">Filters</div>
            <button class="btn btn-action btn-warning w-100"
                    @onclick="OnManageFilters"
                    title="@(SelectedSubscriptionHasAutoforwarding ? "Filters cannot be managed via AMQP on auto-forwarded subscriptions" : "Manage Filters")">
                <i class="bi bi-funnel"></i> Manage Filters
                @if (SelectedSubscriptionHasAutoforwarding)
                {
                    <i class="bi bi-exclamation-triangle-fill ms-1" style="font-size: 0.85rem;" title="Auto-forwarding enabled"></i>
                }
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public bool IsViewingDLQ { get; set; }
    [Parameter] public bool CanSend { get; set; }
    [Parameter] public bool HasQueueOrSubscriptionSelected { get; set; }
    [Parameter] public bool IsPeeking { get; set; }
    [Parameter] public int PeekedMessagesCount { get; set; }
    [Parameter] public bool ArePeekOptionsModified { get; set; }
    [Parameter] public object? CurrentPurgeOperation { get; set; }
    [Parameter] public object? CurrentResubmitOperation { get; set; }
    [Parameter] public bool SelectedEntityRequiresSession { get; set; }
    [Parameter] public bool IsSubscriptionSelected { get; set; }
    [Parameter] public bool SelectedSubscriptionHasAutoforwarding { get; set; }
    
    [Parameter] public EventCallback OnShowSendMessage { get; set; }
    [Parameter] public EventCallback OnToggleDLQ { get; set; }
    [Parameter] public EventCallback OnPeek { get; set; }
    [Parameter] public EventCallback OnPeekNext { get; set; }
    [Parameter] public EventCallback OnShowPeekOptions { get; set; }
    [Parameter] public EventCallback OnResubmitAll { get; set; }
    [Parameter] public EventCallback OnPurge { get; set; }
    [Parameter] public EventCallback OnManageFilters { get; set; }
    [Parameter] public EventCallback OnWatch { get; set; }
    [Parameter] public EventCallback OnPeekNewest { get; set; }

    [Parameter] public PeekOptions? ActivePeekOptions { get; set; }

    private bool _peekMenuOpen;

    private static string DescribeOptions(PeekOptions o)
    {
        var parts = new List<string>();
        if (o.PeekFromNewest) parts.Add("Newest first");
        else if (o.FromSequenceNumber > 0) parts.Add($"From #{o.FromSequenceNumber}");
        if (o.HasActiveFilter) parts.Add("Filtered");
        parts.Add($"{o.MaxCount} per peek");
        return string.Join(" · ", parts);
    }

    private async Task RunMenu(EventCallback action)
    {
        _peekMenuOpen = false;
        await action.InvokeAsync();
    }
}
